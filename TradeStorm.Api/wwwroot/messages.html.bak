<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Повідомлення | Loop Market</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2310b981'><path d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/></svg>">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <style>
        :root {
            --primary: #0f172a;
            --primary-light: #10b981;
            --primary-gradient: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            --accent-green: #10b981;
            --accent-green-grad: linear-gradient(135deg, #10b981 0%, #059669 100%);
            --surface: #ffffff;
            --surface-hover: #f8fafc;
            --bg-color: #f1f5f9;
            --chat-bg: #eef2f6;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --border-focus: #3b82f6;
            --bubble-sent: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            --bubble-sent-text: #ffffff;
            --bubble-received: #ffffff;
            --bubble-received-text: #0f172a;
            --badge-bg: rgba(37, 99, 235, 0.1);
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.04);
            --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.08);
            --shadow-lg: 0 16px 36px rgba(15, 23, 42, 0.12);
        }

        [data-theme="dark"] {
            --primary: #f8fafc;
            --primary-light: #10b981;
            --primary-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            --accent-green: #10b981;
            --accent-green-grad: linear-gradient(135deg, #10b981 0%, #059669 100%);
            --surface: #1e293b;
            --surface-hover: #27354a;
            --bg-color: #0b0f19;
            --chat-bg: #0f172a;
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --border-color: #334155;
            --border-focus: #60a5fa;
            --bubble-sent: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            --bubble-sent-text: #ffffff;
            --bubble-received: #1e293b;
            --bubble-received-text: #f1f5f9;
            --badge-bg: rgba(59, 130, 246, 0.15);
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.25);
            --shadow-md: 0 8px 24px rgba(0,0,0,0.4);
            --shadow-lg: 0 16px 36px rgba(0,0,0,0.5);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* HEADER */
        header {
            background-color: var(--surface);
            border-bottom: 1px solid var(--border-color);
            padding: 0 24px;
            position: sticky;
            top: 0;
            z-index: 1000;
            height: 68px;
            display: flex;
            align-items: center;
            box-shadow: var(--shadow-sm);
        }

        .header-content {
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.45rem;
            font-weight: 800;
            color: var(--text-main);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: -0.5px;
        }

        .logo-circle {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #10b981 0%, #2563eb 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 900;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-link {
            text-decoration: none;
            color: var(--text-muted);
            padding: 8px 14px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .nav-link:hover {
            color: var(--text-main);
            background: var(--surface-hover);
        }

        .nav-link.active {
            color: #2563eb;
            background: var(--badge-bg);
        }

        .btn-create-top {
            background: var(--accent-green-grad);
            color: white;
            padding: 9px 18px;
            border-radius: 12px;
            font-weight: 800;
            font-size: 0.88rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-create-top:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(16, 185, 129, 0.4);
        }

        .btn-icon {
            background: var(--surface-hover);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            transition: all 0.2s;
        }

        .btn-icon:hover {
            border-color: var(--border-focus);
            transform: translateY(-1px);
        }

        .notif-badge {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 8px;
            height: 8px;
            background: #ef4444;
            border-radius: 50%;
            border: 2px solid var(--surface);
        }

        /* NOTIFICATIONS DROPDOWN */
        .notif-dropdown {
            position: absolute;
            top: 72px;
            right: 80px;
            width: 360px;
            background: var(--surface);
            border: 1.5px solid var(--border-color);
            border-radius: 16px;
            box-shadow: var(--shadow-lg);
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 1500;
        }

        .notif-header {
            padding: 14px 18px;
            border-bottom: 1px solid var(--border-color);
            font-weight: 800;
            font-size: 0.95rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notif-body {
            max-height: 380px;
            overflow-y: auto;
        }

        .notif-item {
            padding: 12px 18px;
            border-bottom: 1px solid var(--border-color);
            text-decoration: none;
            color: var(--text-main);
            display: block;
            transition: background 0.15s;
        }

        .notif-item:hover {
            background: var(--surface-hover);
        }

        .notif-item.unread {
            background: rgba(37, 99, 235, 0.05);
            border-left: 3px solid #2563eb;
        }

        /* MAIN MESSENGER WRAPPER */
        main {
            flex: 1;
            display: flex;
            padding: 16px 24px 20px;
            max-width: 1600px;
            width: 100%;
            margin: 0 auto;
            height: calc(100vh - 68px);
            min-height: 580px;
        }

        .messenger-card {
            width: 100%;
            height: 100%;
            background: var(--surface);
            border-radius: 20px;
            border: 1.5px solid var(--border-color);
            box-shadow: var(--shadow-md);
            display: grid;
            grid-template-columns: 380px 1fr;
            overflow: hidden;
        }

        /* SIDEBAR (LEFT) */
        .messenger-sidebar {
            background: var(--surface);
            border-right: 1.5px solid var(--border-color);
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
        }

        .sidebar-top {
            padding: 18px 20px 14px;
            border-bottom: 1px solid var(--border-color);
        }

        .sidebar-headline {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .sidebar-headline h2 {
            font-size: 1.35rem;
            font-weight: 800;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .dialog-unread-pill {
            background: #2563eb;
            color: white;
            font-size: 0.75rem;
            font-weight: 800;
            padding: 2px 8px;
            border-radius: 12px;
        }

        .search-box-wrap {
            position: relative;
            margin-bottom: 10px;
        }

        .search-box-wrap svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .chat-search-input {
            width: 100%;
            background: var(--bg-color);
            border: 1.5px solid var(--border-color);
            border-radius: 12px;
            padding: 10px 14px 10px 38px;
            font-size: 0.88rem;
            color: var(--text-main);
            outline: none;
            transition: all 0.2s;
        }

        .chat-search-input:focus {
            border-color: var(--border-focus);
            background: var(--surface);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        /* FILTER CHIPS (TABS) */
        .chat-filter-tabs {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none; /* IE / Edge */
            padding-bottom: 2px;
        }

        .chat-filter-tabs::-webkit-scrollbar {
            display: none; /* Chrome / Safari / Edge */
            width: 0;
            height: 0;
        }

        .chat-filter-tab {
            flex: 1;
            text-align: center;
            padding: 7px 6px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
            background: var(--surface);
            color: var(--text-muted);
            font-size: 0.78rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.18s;
        }

        .chat-filter-tab:hover {
            color: var(--text-main);
            background: var(--surface-hover);
        }

        .chat-filter-tab.active {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
        }

        /* DIALOGS LIST */
        .dialogs-scroll-area {
            flex: 1;
            overflow-y: auto;
            min-height: 0;
            padding: 8px;
        }

        .dialogs-scroll-area::-webkit-scrollbar {
            width: 5px;
        }

        .dialogs-scroll-area::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }

        .chat-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.18s ease;
            position: relative;
            margin-bottom: 4px;
            border: 1px solid transparent;
        }

        .chat-item:hover {
            background: var(--surface-hover);
        }

        .chat-item.active {
            background: var(--badge-bg);
            border-color: rgba(37, 99, 235, 0.35);
        }

        .chat-avatar-box {
            position: relative;
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
            font-weight: 800;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            overflow: visible;
        }

        .chat-avatar-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 14px;
        }

        .avatar-online-dot {
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 13px;
            height: 13px;
            background: #10b981;
            border: 2.5px solid var(--surface);
            border-radius: 50%;
            box-shadow: 0 0 0 1px rgba(16, 185, 129, 0.4);
        }

        .chat-item-meta {
            flex: 1;
            min-width: 0;
        }

        .chat-item-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 3px;
        }

        .chat-item-name {
            font-weight: 800;
            font-size: 0.94rem;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .chat-item-time {
            font-size: 0.74rem;
            color: var(--text-muted);
            font-weight: 600;
            flex-shrink: 0;
        }

        .chat-item-snippet-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
        }

        .chat-item-last-msg {
            font-size: 0.82rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex: 1;
        }

        .chat-item.unread .chat-item-last-msg {
            color: var(--text-main);
            font-weight: 700;
        }

        .new-draft-pill {
            font-size: 0.72rem;
            font-weight: 800;
            color: #2563eb;
            background: rgba(37, 99, 235, 0.12);
            padding: 2px 7px;
            border-radius: 6px;
            white-space: nowrap;
        }

        .unread-msg-badge {
            background: #2563eb;
            color: white;
            font-size: 0.72rem;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 10px;
            flex-shrink: 0;
        }

        /* MAIN CHAT WINDOW (RIGHT) */
        .messenger-chat-pane {
            display: flex;
            flex-direction: column;
            height: 100%;
            background: radial-gradient(circle at 90% 10%, rgba(37, 99, 235, 0.08) 0%, transparent 45%), radial-gradient(circle at 10% 90%, rgba(16, 185, 129, 0.06) 0%, transparent 45%), var(--chat-bg);
            position: relative;
            min-height: 0;
        }

        .chat-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            margin-bottom: 6px;
            border: 1px solid transparent;
        }

        .chat-item:hover {
            background: var(--surface-hover);
            transform: translateX(4px);
            border-color: rgba(37, 99, 235, 0.2);
        }

        .chat-item.active {
            background: var(--badge-bg);
            border-color: rgba(37, 99, 235, 0.4);
            border-left: 4px solid #2563eb;
            transform: translateX(2px);
        }

        @keyframes online-pulse {
            0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
            100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        .avatar-online-dot {
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 13px;
            height: 13px;
            background: #10b981;
            border: 2.5px solid var(--surface);
            border-radius: 50%;
            animation: online-pulse 2s infinite;
        }

        /* CHAT HEADER */
        .chat-pane-header {
            background: var(--surface);
            border-bottom: 1.5px solid var(--border-color);
            padding: 12px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            z-index: 10;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }

        .chat-pane-user-info {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
        }

        .pane-avatar {
            width: 44px;
            height: 44px;
            border-radius: 13px;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 1.05rem;
            position: relative;
            flex-shrink: 0;
        }

        .pane-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 13px;
        }

        .pane-user-text {
            min-width: 0;
        }

        .pane-user-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--text-main);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            line-height: 1.25;
        }

        .pane-user-title:hover {
            color: #2563eb;
        }

        .role-tag-pill {
            font-size: 0.72rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 6px;
            background: rgba(37, 99, 235, 0.1);
            color: #2563eb;
        }

        .pane-status-line {
            font-size: 0.78rem;
            color: #10b981;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 2px;
        }

        .pane-status-dot {
            width: 7px;
            height: 7px;
            background: #10b981;
            border-radius: 50%;
            animation: pulse-dot 2s infinite;
        }

        @keyframes pulse-dot {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.3); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }

        .chat-pane-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .btn-header-action {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border-radius: 10px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            border: 1px solid var(--border-color);
            background: var(--surface-hover);
            color: var(--text-main);
            transition: all 0.18s;
        }

        .btn-header-action:hover {
            border-color: var(--border-focus);
            background: var(--surface);
            color: #2563eb;
        }

        .btn-header-action.danger:hover {
            border-color: #ef4444;
            color: #ef4444;
            background: rgba(239, 68, 68, 0.08);
        }

        /* CONTEXT ITEM / SERVICE BANNER */
        .chat-context-listing-banner {
            background: var(--surface);
            border-bottom: 1px solid var(--border-color);
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            animation: slideDown 0.25s ease;
        }

        @keyframes slideDown {
            from { transform: translateY(-10px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .context-listing-left {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .context-listing-img {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            object-fit: cover;
            border: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        .context-listing-meta {
            min-width: 0;
        }

        .context-listing-tag {
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            padding: 2px 6px;
            border-radius: 5px;
            background: rgba(16, 185, 129, 0.12);
            color: #10b981;
            display: inline-block;
            margin-bottom: 2px;
        }

        .context-listing-tag.service {
            background: rgba(37, 99, 235, 0.12);
            color: #2563eb;
        }

        .context-listing-title {
            font-weight: 800;
            font-size: 0.92rem;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .context-listing-price {
            font-weight: 800;
            font-size: 0.98rem;
            color: #2563eb;
            white-space: nowrap;
        }

        .btn-view-listing {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 700;
            background: var(--surface-hover);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            text-decoration: none;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .btn-view-listing:hover {
            border-color: #2563eb;
            color: #2563eb;
            background: var(--surface);
        }

        /* MESSAGES STREAM */
        .chat-stream-area {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 0;
        }

        .chat-stream-area::-webkit-scrollbar {
            width: 6px;
        }

        .chat-stream-area::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 4px;
        }

        /* EMPTY CHAT SCREEN */
        .chat-empty-state {
            margin: auto;
            text-align: center;
            max-width: 420px;
            padding: 30px 20px;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .empty-chat-icon {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background: var(--badge-bg);
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
        }

        .empty-chat-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 8px;
        }

        .empty-chat-subtitle {
            font-size: 0.88rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 18px;
        }

        /* MESSAGE BUBBLES */
        .msg-bubble {
            max-width: 68%;
            padding: 10px 14px;
            border-radius: 16px;
            font-size: 0.92rem;
            line-height: 1.45;
            word-wrap: break-word;
            position: relative;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            animation: popMsg 0.2s cubic-bezier(0.18, 0.89, 0.32, 1.28);
        }

        @keyframes popMsg {
            from { transform: scale(0.95); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        .msg-sent {
            align-self: flex-end;
            background: var(--bubble-sent);
            color: var(--bubble-sent-text);
            border-bottom-right-radius: 4px;
        }

        .msg-received {
            align-self: flex-start;
            background: var(--bubble-received);
            color: var(--bubble-received-text);
            border: 1px solid var(--border-color);
            border-bottom-left-radius: 4px;
        }

        .msg-time-row {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 4px;
            margin-top: 4px;
            font-size: 0.72rem;
            opacity: 0.85;
        }

        .msg-sent .msg-time-row {
            color: rgba(255, 255, 255, 0.85);
        }

        .msg-received .msg-time-row {
            color: var(--text-muted);
        }

        .msg-photo-thumb {
            max-width: 240px;
            border-radius: 10px;
            margin-top: 4px;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .msg-photo-thumb:hover {
            transform: scale(1.02);
        }

        /* QUICK SUGGESTION CHIPS */
        .quick-chips-wrapper {
            padding: 8px 18px;
            background: var(--surface);
            border-top: 1px solid var(--border-color);
            display: flex;
            gap: 8px;
            overflow-x: auto;
            flex-shrink: 0;
        }

        .quick-chips-wrapper::-webkit-scrollbar {
            display: none;
        }

        .quick-chip-btn {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--text-main);
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.18s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .quick-chip-btn:hover {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
            transform: translateY(-1px);
        }

        /* MESSAGE INPUT BAR */
        .chat-input-bar {
            background: var(--surface);
            border-top: 1.5px solid var(--border-color);
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            position: relative;
        }

        .btn-input-tool {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.18s;
            flex-shrink: 0;
        }

        .btn-input-tool:hover {
            color: #2563eb;
            background: var(--surface-hover);
            border-color: var(--border-focus);
        }

        .main-msg-input {
            flex: 1;
            background: var(--bg-color);
            border: 1.5px solid var(--border-color);
            border-radius: 14px;
            padding: 12px 18px;
            font-size: 0.94rem;
            color: var(--text-main);
            outline: none;
            transition: all 0.2s;
        }

        .main-msg-input:focus {
            border-color: var(--border-focus);
            background: var(--surface);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .btn-send-message {
            padding: 0 20px;
            height: 44px;
            border-radius: 14px;
            background: var(--primary-gradient);
            border: none;
            color: white;
            font-weight: 800;
            font-size: 0.94rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .btn-send-message:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.45);
        }

        /* EMOJI QUICK ROW */
        .emoji-quick-bar {
            position: absolute;
            bottom: 74px;
            left: 20px;
            background: var(--surface);
            border: 1.5px solid var(--border-color);
            border-radius: 14px;
            padding: 6px 10px;
            box-shadow: var(--shadow-lg);
            display: none;
            gap: 8px;
            z-index: 100;
        }

        .emoji-pill {
            font-size: 1.3rem;
            cursor: pointer;
            padding: 4px 6px;
            border-radius: 8px;
            transition: transform 0.15s;
        }

        .emoji-pill:hover {
            transform: scale(1.25);
            background: var(--surface-hover);
        }

        /* REVIEWS MODAL */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.65);
            backdrop-filter: blur(6px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 2000;
        }

        .modal-card {
            background: var(--surface);
            border-radius: 20px;
            padding: 26px 28px;
            width: 90%;
            max-width: 440px;
            border: 1.5px solid var(--border-color);
            box-shadow: var(--shadow-lg);
        }

        /* RESPONSIVE */
        @media (max-width: 860px) {
            main {
                padding: 10px;
                height: calc(100vh - 68px);
            }
            .messenger-card {
                grid-template-columns: 1fr;
            }
            .messenger-sidebar.mobile-hide {
                display: none;
            }
            .messenger-chat-pane.mobile-hide {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- ==================== HEADER ==================== -->
    <header>
        <div class="header-content">
            <a href="/index.html" class="logo">
                <div class="logo-circle">L</div>
                <span>Loop<span style="color: #10b981;">Market</span></span>
            </a>

            <div class="nav-actions">
                <a href="/index.html" class="nav-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                    Головна
                </a>
                <a href="/index.html?type=service" class="nav-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    Послуги
                </a>
                <a href="/messages.html" class="nav-link active">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Чат
                </a>
                <a href="/profile.html" class="nav-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Профіль
                </a>

                <button class="btn-icon" onclick="toggleNotifications()" title="Сповіщення">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                    <span class="notif-badge" id="notifBadge" style="display: none;"></span>
                </button>

                <button class="btn-icon" id="themeToggle" onclick="toggleTheme()" title="Змінити тему">🌙</button>

                <a href="/create.html" class="btn-create-top">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                    Створити
                </a>

                <button class="btn-icon" onclick="showLogoutModal()" title="Вийти з акаунта" style="color: #ef4444;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                </button>
            </div>
        </div>

        <!-- Дропдаун сповіщень -->
        <div class="notif-dropdown" id="notifDropdown">
            <div class="notif-header">
                <span>Сповіщення</span>
                <span style="font-size: 0.8rem; color: #2563eb; cursor: pointer;" onclick="clearNotifications()">Позначити прочитаними</span>
            </div>
            <div class="notif-body" id="notifList">
                <p style="padding: 16px; text-align: center; color: var(--text-muted); font-size: 0.85rem;">Немає нових сповіщень</p>
            </div>
        </div>
    </header>

    <!-- ==================== MESSENGER CONTAINER ==================== -->
    <main>
        <div class="messenger-card">

            <!-- ЛІВА КОЛОНКА: ДІАЛОГИ -->
            <div class="messenger-sidebar" id="sidebarPane">
                <div class="sidebar-top">
                    <div class="sidebar-headline">
                        <h2>
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            Діалоги
                        </h2>
                        <span class="dialog-unread-pill" id="totalDialogsCount">0</span>
                    </div>

                    <div class="search-box-wrap">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <input type="text" id="chatSearchInput" class="chat-search-input" placeholder="Пошук діалогів за ім'ям..." oninput="filterDialogs(this.value)">
                    </div>

                    <div class="chat-filter-tabs">
                        <button class="chat-filter-tab active" onclick="setFilterTab('all', this)">Всі</button>
                        <button class="chat-filter-tab" onclick="setFilterTab('unread', this)">Непрочитані</button>
                        <button class="chat-filter-tab" onclick="setFilterTab('services', this)">🛠 Послуги</button>
                        <button class="chat-filter-tab" onclick="setFilterTab('products', this)">📦 Товари</button>
                    </div>
                </div>

                <!-- Список активних діалогів -->
                <div class="dialogs-scroll-area" id="dialogsContainer">
                    <p style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 0.88rem;">Завантаження діалогів...</p>
                </div>
            </div>

            <!-- ПРАВА КОЛОНКА: ЧАТ З ОБРАНИМ КОРИСТУВАЧЕМ -->
            <div class="messenger-chat-pane" id="chatPane">

                <!-- ШАПКА АКТИВНОГО ЧАТУ -->
                <div class="chat-pane-header">
                    <div class="chat-pane-user-info">
                        <div class="pane-avatar" id="activeChatAvatar" style="background: linear-gradient(135deg, #10b981 0%, #2563eb 100%); font-size: 1.15rem;">💬</div>
                        <div class="pane-user-text">
                            <a href="#" id="activeChatNameLink" class="pane-user-title">
                                <span id="activeChatName">Особисті повідомлення</span>
                                <span class="role-tag-pill" id="activeChatRole" style="display: none;">Майстер</span>
                            </a>
                            <div class="pane-status-line" id="activeChatStatus">
                                <span class="pane-status-dot"></span>
                                <span id="activeChatStatusText">Loop Messenger • Швидкі та безпечні угоди</span>
                                <span id="activeChatMsgCount" style="color: var(--text-muted); font-size: 0.74rem; margin-left: 6px;"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Кнопки дій у шапці -->
                    <div class="chat-pane-actions" id="headerActions" style="display: none;">
                        <a href="#" id="btnSellerProfile" class="btn-header-action" title="Переглянути профіль автора">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <span>Профіль</span>
                        </a>
                        <a href="#" id="btnCallSeller" class="btn-header-action" title="Зателефонувати" style="display: none;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            <span>Дзвінок</span>
                        </a>
                        <button type="button" class="btn-header-action" onclick="openReviewModal()" title="Оцінити роботу автора">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            <span>Оцінити</span>
                        </button>
                        <button type="button" class="btn-header-action danger" onclick="deleteChat()" title="Очистити листування">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                        </button>
                    </div>
                </div>

                <!-- БАНЕР ОГОЛОШЕННЯ (ТОВАРУ ЧИ ПОСЛУГИ) -->
                <div class="chat-context-listing-banner" id="productBadge" style="display: none;">
                    <div class="context-listing-left">
                        <img id="productThumb" src="" class="context-listing-img" alt="Оголошення">
                        <div class="context-listing-meta">
                            <div class="context-listing-tag" id="productTag">Товар</div>
                            <div class="context-listing-title" id="productTitle">Назва оголошення</div>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px; flex-shrink: 0;">
                        <span class="context-listing-price" id="productPrice">0 ₴</span>
                        <a href="#" id="productLink" class="btn-view-listing" target="_blank">Переглянути →</a>
                    </div>
                </div>

                <!-- СТРІЧКА ПОВІДОМЛЕНЬ -->
                <div class="chat-stream-area" id="chatArea">
                    <div class="chat-empty-state" style="max-width: 520px;">
                        <div class="empty-chat-icon" style="width: 76px; height: 76px; border-radius: 24px; background: linear-gradient(135deg, rgba(37,99,235,0.15) 0%, rgba(16,185,129,0.15) 100%); border: 1.5px solid rgba(37,99,235,0.3); color: #2563eb; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: 0 8px 24px rgba(37,99,235,0.15);">
                            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </div>
                        <h3 class="empty-chat-title" style="font-size: 1.4rem; font-weight: 800; margin-bottom: 10px;">Оберіть діалог або напишіть автору</h3>
                        <p class="empty-chat-subtitle" style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.55; margin-bottom: 22px;">
                            Спілкуйтеся напряму з продавцями та майстрами послуг. Обговорюйте час зустрічі, деталі замовлення або уточнюйте ціну.
                        </p>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 24px; text-align: left;">
                            <div style="background: var(--surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 12px; box-shadow: var(--shadow-sm);">
                                <div style="font-size: 1.2rem; margin-bottom: 4px;">⚡</div>
                                <div style="font-weight: 800; font-size: 0.82rem; color: var(--text-main);">Миттєвий чат</div>
                                <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">Сповіщення в реальному часі</div>
                            </div>
                            <div style="background: var(--surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 12px; box-shadow: var(--shadow-sm);">
                                <div style="font-size: 1.2rem; margin-bottom: 4px;">🔒</div>
                                <div style="font-weight: 800; font-size: 0.82rem; color: var(--text-main);">Loop Захист</div>
                                <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">Безпечні розрахунки</div>
                            </div>
                            <div style="background: var(--surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 12px; box-shadow: var(--shadow-sm);">
                                <div style="font-size: 1.2rem; margin-bottom: 4px;">📱</div>
                                <div style="font-weight: 800; font-size: 0.82rem; color: var(--text-main);">Telegram Пуші</div>
                                <div style="font-size: 0.74rem; color: var(--text-muted); margin-top: 2px;">Дублювання автору в бот</div>
                            </div>
                        </div>

                        <button type="button" id="btnOpenLatestDialog" onclick="openFirstDialog()" style="padding: 12px 24px; border-radius: 14px; background: var(--primary-gradient); color: white; font-weight: 800; font-size: 0.95rem; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 16px rgba(37,99,235,0.35); transition: transform 0.2s;">
                            <span>Відкрити останній діалог</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </button>
                    </div>
                </div>

                <!-- ШВИДКІ ПІДКАЗКИ (CHIPS) -->
                <div class="quick-chips-wrapper" id="quickChips" style="display: none;">
                    <!-- Динамічно заповнюються залежно від типу (послуга чи товар) -->
                </div>

                <!-- ПАНЕЛЬ ВВЕДЕННЯ ПОВІДОМЛЕННЯ -->
                <div class="chat-input-bar" id="inputBar" style="display: none;">
                    <!-- Меню емодзі -->
                    <div class="emoji-quick-bar" id="emojiQuickBar">
                        <span class="emoji-pill" onclick="insertEmoji('👋')">👋</span>
                        <span class="emoji-pill" onclick="insertEmoji('🤝')">🤝</span>
                        <span class="emoji-pill" onclick="insertEmoji('👍')">👍</span>
                        <span class="emoji-pill" onclick="insertEmoji('📦')">📦</span>
                        <span class="emoji-pill" onclick="insertEmoji('🛠')">🛠</span>
                        <span class="emoji-pill" onclick="insertEmoji('📍')">📍</span>
                        <span class="emoji-pill" onclick="insertEmoji('🔥')">🔥</span>
                        <span class="emoji-pill" onclick="insertEmoji('✅')">✅</span>
                    </div>

                    <input type="file" id="photoInput" accept="image/*" style="display: none;" onchange="handlePhotoSelect(event)">
                    <button type="button" class="btn-input-tool" title="Прикріпити фото" onclick="document.getElementById('photoInput').click()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    </button>

                    <button type="button" class="btn-input-tool" title="Швидкі реакції" onclick="toggleEmojiQuickBar()">
                        😊
                    </button>

                    <input type="text" class="main-msg-input" id="messageInput" placeholder="Напишіть повідомлення... (Enter для надсилання)" autocomplete="off">

                    <button type="button" class="btn-send-message" onclick="sendMessage()">
                        <span>Надіслати</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- ==================== МОДАЛЬНІ ВІКНА ==================== -->
    <!-- Модальне вікно виходу -->
    <div class="modal-overlay" id="logoutModal">
        <div class="modal-card">
            <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 8px; color: var(--text-main);">Вихід з акаунта</h3>
            <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 20px;">Ви дійсно бажаєте вийти зі свого облікового запису на цьому пристрої?</p>
            <div style="display: flex; gap: 10px;">
                <button type="button" onclick="closeLogoutModal()" style="flex: 1; padding: 11px; border-radius: 12px; border: 1px solid var(--border-color); background: var(--surface); color: var(--text-main); font-weight: 700; cursor: pointer;">Скасувати</button>
                <button type="button" onclick="confirmLogoutAction()" style="flex: 1; padding: 11px; border-radius: 12px; border: none; background: #ef4444; color: white; font-weight: 800; cursor: pointer;">Вийти</button>
            </div>
        </div>
    </div>

    <!-- Модальне вікно відгуку -->
    <div class="modal-overlay" id="reviewModal">
        <div class="modal-card">
            <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 14px; color: var(--text-main);">Оцінити користувача</h3>
            <form onsubmit="submitReview(event)">
                <div style="margin-bottom: 14px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">Оцінка за співпрацю:</label>
                    <select id="reviewRating" style="width: 100%; box-sizing: border-box; background: var(--bg-color); border: 1.5px solid var(--border-color); border-radius: 10px; padding: 10px; color: var(--text-main); font-weight: 700; outline: none;">
                        <option value="5">⭐⭐⭐⭐⭐ 5 / 5 (Відмінно, рекомендую)</option>
                        <option value="4">⭐⭐⭐⭐ 4 / 5 (Добре)</option>
                        <option value="3">⭐⭐⭐ 3 / 5 (Нормально)</option>
                        <option value="2">⭐⭐ 2 / 5 (Погано)</option>
                        <option value="1">⭐ 1 / 5 (Не рекомендую)</option>
                    </select>
                </div>
                <div style="margin-bottom: 18px;">
                    <label style="display: block; font-size: 0.85rem; font-weight: 700; color: var(--text-muted); margin-bottom: 6px;">Коментар або враження:</label>
                    <textarea id="reviewComment" rows="3" placeholder="Розкажіть про пунктуальність, якість робіт чи товару..." style="width: 100%; box-sizing: border-box; background: var(--bg-color); border: 1.5px solid var(--border-color); border-radius: 10px; padding: 10px; color: var(--text-main); font-size: 0.9rem; outline: none; resize: vertical;"></textarea>
                </div>
                <div style="display: flex; gap: 10px;">
                    <button type="button" onclick="closeReviewModal()" style="flex: 1; padding: 11px; border-radius: 12px; border: 1px solid var(--border-color); background: var(--surface); color: var(--text-main); font-weight: 700; cursor: pointer;">Скасувати</button>
                    <button type="submit" style="flex: 1; padding: 11px; border-radius: 12px; border: none; background: var(--primary-gradient); color: white; font-weight: 800; cursor: pointer;">Надіслати відгук</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Модальне вікно перегляду зображення -->
    <div class="modal-overlay" id="photoModal" onclick="this.style.display='none'">
        <img id="modalImg" src="" style="max-width: 90vw; max-height: 90vh; border-radius: 14px; box-shadow: var(--shadow-lg);" onclick="event.stopPropagation()">
    </div>

    <!-- ==================== СИСТЕМА ЛОГІКИ ТА SIGNALR ==================== -->
    <script>
        const token = localStorage.getItem('loopToken');
        let currentUserId = null;
        let activeReceiverId = null;
        let activeItemContext = null;
        let allDialogsCache = [];
        let currentFilterTab = 'all';

        // Перевірка авторизації
        if (!token) {
            window.location.href = '/login.html';
        } else {
            try {
                const user = parseJwt(token);
                if (user) {
                    currentUserId = parseInt(user["http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier"]);
                }
            } catch(e) {
                console.error("JWT parse error:", e);
            }
        }

        function parseJwt(t) {
            try {
                const base64Url = t.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
                return JSON.parse(jsonPayload);
            } catch(e) { return null; }
        }

        // Керування темою
        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-theme') || 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('loopTheme', next);
            updateThemeButton(next);
        }
        function updateThemeButton(t) {
            const btn = document.getElementById('themeToggle');
            if (btn) btn.innerText = (t === 'dark') ? '☀️' : '🌙';
        }
        const savedTheme = localStorage.getItem('loopTheme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        updateThemeButton(savedTheme);

        // SIGNALR З'ЄДНАННЯ
        let connection = null;
        try {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chathub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMessage", (senderId, receiverId, text) => {
                const sid = parseInt(senderId);
                const rid = parseInt(receiverId);
                if (sid === activeReceiverId || rid === activeReceiverId) {
                    appendMessage(text, sid === currentUserId ? 'sent' : 'received', new Date(), false);
                    if (sid === activeReceiverId) {
                        fetch(`/api/messages/mark-read/${activeReceiverId}`, {
                            method: 'POST',
                            headers: { 'Authorization': `Bearer ${token}` }
                        }).catch(() => {});
                    }
                }
                loadDialogs();
                loadNotifications();
            });

            async function startSignalR() {
                try {
                    await connection.start();
                    if (currentUserId) {
                        await connection.invoke("RegisterUser", currentUserId);
                    }
                } catch (err) {
                    setTimeout(startSignalR, 6000);
                }
            }
            startSignalR();
        } catch(e) {
            console.log("SignalR not initialized, using REST fallback:", e);
        }

        // СТАРТ СТОРІНКИ
        document.addEventListener('DOMContentLoaded', async () => {
            const params = new URLSearchParams(window.location.search);
            const sellerParam = params.get('seller') || params.get('sellerId') || params.get('userId') || params.get('user');
            const itemParam = params.get('item') || params.get('itemId') || params.get('listingId');

            await loadDialogs();
            await loadNotifications();
            setInterval(loadNotifications, 15000);

            if (sellerParam) {
                const targetId = parseInt(sellerParam);
                if (targetId && targetId !== currentUserId) {
                    await selectDialog(targetId, itemParam);
                } else if (targetId === currentUserId) {
                    alert("Це ваш власний акаунт. Ви не можете надіслати повідомлення самі собі.");
                }
            }
        });

        // ЗАВАНТАЖЕННЯ ДІАЛОГІВ
        async function loadDialogs() {
            try {
                const res = await fetch('/api/messages/dialogs', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    const data = await res.json();
                    allDialogsCache = data || [];
                }
            } catch(e) {
                console.error("Error loading dialogs:", e);
            }
            renderDialogs(allDialogsCache);
        }

        // РЕНДЕР АВАТАРА
        function renderAvatarContent(userObj, defaultName) {
            const init = (((defaultName || 'U')[0]) || 'U').toUpperCase();
            const savedAvatar = userObj && userObj.id ? localStorage.getItem(`userAvatar_${userObj.id}`) : null;
            const url = savedAvatar || (userObj && userObj.avatarUrl);
            if (url && typeof url === 'string' && url.trim()) {
                return `<img src="${url}" alt="Avatar" onerror="this.remove(); this.parentElement.innerText='${init}';">`;
            }
            return init;
        }

        // РЕНДЕР СПИСКУ ДІАЛОГІВ
        function renderDialogs(partners) {
            const container = document.getElementById('dialogsContainer');
            const totalPill = document.getElementById('totalDialogsCount');
            if (totalPill) totalPill.innerText = partners.length;

            if (!partners || !partners.length) {
                container.innerHTML = `
                    <div style="padding: 30px 16px; text-align: center; color: var(--text-muted);">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="opacity: 0.5; margin-bottom: 8px;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        <p style="font-weight: 700; font-size: 0.92rem; color: var(--text-main); margin-bottom: 4px;">Немає діалогів</p>
                        <p style="font-size: 0.8rem;">Знайдіть товар або послугу та напишіть автору!</p>
                    </div>`;
                return;
            }

            container.innerHTML = partners.map(p => {
                const isCurrent = p.id === activeReceiverId;
                const timeStr = p.lastMessageTime ? formatTime(p.lastMessageTime) : '';
                const fullName = `${p.firstName || 'Користувач'} ${p.lastName || ''}`.trim();
                return `
                    <div class="chat-item ${isCurrent ? 'active' : ''} ${p.isWaiting ? 'unread' : ''}" onclick="selectDialog(${p.id})">
                        <div class="chat-avatar-box">
                            ${renderAvatarContent(p, p.firstName)}
                            <div class="avatar-online-dot"></div>
                        </div>
                        <div class="chat-item-meta">
                            <div class="chat-item-header">
                                <span class="chat-item-name">${fullName}</span>
                                <span class="chat-item-time">${timeStr}</span>
                            </div>
                            <div class="chat-item-snippet-row">
                                <span class="chat-item-last-msg">${p.isDraft ? '<span class="new-draft-pill">Новий діалог</span>' : (p.lastMessage || 'Натисніть для листування')}</span>
                                ${p.isWaiting ? '<span class="unread-msg-badge">•</span>' : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function formatTime(iso) {
            try {
                const d = new Date(iso);
                const now = new Date();
                if (d.toDateString() === now.toDateString()) {
                    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }
                return d.toLocaleDateString([], { day: '2-digit', month: '2-digit' });
            } catch(e) { return ''; }
        }

        // ФІЛЬТРАЦІЯ
        function filterDialogs(query) {
            const q = (query || '').toLowerCase().trim();
            const filtered = allDialogsCache.filter(p => {
                const name = `${p.firstName || ''} ${p.lastName || ''}`.toLowerCase();
                return name.includes(q) || (p.lastMessage && p.lastMessage.toLowerCase().includes(q));
            });
            renderDialogs(filtered);
        }

        function openFirstDialog() {
            if (allDialogsCache && allDialogsCache.length > 0) {
                selectDialog(allDialogsCache[0].id);
            } else {
                window.location.href = '/index.html';
            }
        }

        function setFilterTab(tab, btn) {
            currentFilterTab = tab;
            document.querySelectorAll('.chat-filter-tab').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            if (tab === 'unread') {
                renderDialogs(allDialogsCache.filter(p => p.isWaiting));
            } else if (tab === 'services') {
                renderDialogs(allDialogsCache.filter(p => (p.lastMessage && p.lastMessage.toLowerCase().includes('послуг')) || p.isService));
            } else if (tab === 'products') {
                renderDialogs(allDialogsCache.filter(p => !p.isService));
            } else {
                renderDialogs(allDialogsCache);
            }
        }

        // ГОЛОВНА ФУНКЦІЯ: ОБРАТИ ДІАЛОГ / ВІДКРИТИ ЧАТ З ПРОДАВЦЕМ
        async function selectDialog(partnerId, itemId = null) {
            if (!partnerId) return;
            activeReceiverId = partnerId;

            // 1. Оновлюємо активний елемент списку
            document.querySelectorAll('.chat-item').forEach(el => el.classList.remove('active'));

            // 2. Спроба знайти інформацію про користувача в кеші або через публічний API
            let partnerData = allDialogsCache.find(p => p.id === partnerId);

            // Якщо партнер ще не в списку діалогів (перше повідомлення від покупця/замовника)
            if (!partnerData) {
                try {
                    const uRes = await fetch(`/api/users/public/${partnerId}`);
                    if (uRes.ok) {
                        partnerData = await uRes.json();
                    }
                } catch(e) {}
            }

            // Якщо є itemId — завантажуємо повні дані про оголошення напряму
            let listingItem = null;
            if (itemId) {
                try {
                    const lRes = await fetch(`/api/listings/${itemId}`);
                    if (lRes.ok) {
                        listingItem = await lRes.json();
                        if (!partnerData && listingItem.seller) {
                            partnerData = listingItem.seller;
                        }
                    }
                } catch(e) {}
            }

            const pFirst = (partnerData && partnerData.firstName) ? partnerData.firstName : 'Користувач';
            const pLast = (partnerData && partnerData.lastName) ? partnerData.lastName : '';
            const partnerFullName = `${pFirst} ${pLast}`.trim();

            // Якщо це новий діалог — синтезуємо його у списку зліва, щоб продавець з'явився одразу
            if (!allDialogsCache.some(p => p.id === partnerId)) {
                allDialogsCache.unshift({
                    id: partnerId,
                    firstName: pFirst,
                    lastName: pLast,
                    avatarUrl: partnerData ? partnerData.avatarUrl : null,
                    phoneNumber: partnerData ? partnerData.phoneNumber : null,
                    lastMessage: 'Новий діалог (напишіть повідомлення)',
                    lastMessageTime: new Date().toISOString(),
                    isWaiting: false,
                    isDraft: true,
                    isService: listingItem ? (listingItem.categoryId === 8 || listingItem.title.toLowerCase().includes('послуг')) : false
                });
                renderDialogs(allDialogsCache);
            }

            // 3. Заповнюємо шапку активного чату
            document.getElementById('activeChatName').innerText = partnerFullName;
            const nameLink = document.getElementById('activeChatNameLink');
            if (nameLink) nameLink.href = `/seller.html?id=${partnerId}`;

            const rolePill = document.getElementById('activeChatRole');
            const isServ = listingItem ? (listingItem.categoryId === 8 || listingItem.title.toLowerCase().includes('послуг')) : false;
            if (rolePill) {
                rolePill.style.display = 'inline-block';
                rolePill.innerText = isServ ? 'Майстер послуги' : 'Продавець';
            }

            document.getElementById('activeChatAvatar').innerHTML = `${renderAvatarContent(partnerData, pFirst)}<div class="avatar-online-dot"></div>`;
            document.getElementById('headerActions').style.display = 'flex';
            document.getElementById('btnSellerProfile').href = `/seller.html?id=${partnerId}`;

            const phone = partnerData ? (partnerData.phoneNumber || (listingItem && listingItem.seller ? listingItem.seller.phoneNumber : null)) : null;
            const callBtn = document.getElementById('btnCallSeller');
            if (phone) {
                callBtn.href = `tel:+${phone}`;
                callBtn.style.display = 'inline-flex';
            } else {
                callBtn.style.display = 'none';
            }

            // 4. Заповнюємо банер оголошення (якщо передано item або знайдено)
            const badge = document.getElementById('productBadge');
            if (listingItem) {
                activeItemContext = listingItem;
                document.getElementById('productTitle').innerText = listingItem.title;
                document.getElementById('productPrice').innerText = `${listingItem.price} ₴`;
                document.getElementById('productThumb').src = (listingItem.imageUrls && listingItem.imageUrls.length > 0) ? listingItem.imageUrls[0] : (listingItem.imageUrl || 'https://placehold.co/100x100/1e293b/10b981?text=Loop');
                
                const tagEl = document.getElementById('productTag');
                if (isServ) {
                    tagEl.className = 'context-listing-tag service';
                    tagEl.innerText = '🛠 Послуга';
                } else {
                    tagEl.className = 'context-listing-tag';
                    tagEl.innerText = '📦 Товар';
                }

                document.getElementById('productLink').href = `/details.html?id=${listingItem.id}`;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }

            // 5. Контекстні швидкі підказки (chips)
            setupQuickChips(isServ, listingItem);

            // 6. Показуємо панель введення та фокусуємо інпут
            document.getElementById('inputBar').style.display = 'flex';
            const msgInput = document.getElementById('messageInput');
            setTimeout(() => { msgInput.focus(); }, 100);

            // 7. Позначаємо як прочитані на бекенді
            fetch(`/api/messages/mark-read/${partnerId}`, {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}` }
            }).catch(() => {});

            // 8. Завантажуємо історію повідомлень
            await loadChatHistory(partnerId, partnerFullName);
        }

        // КОНТЕКСТНІ ШВИДКІ КНОПКИ
        function setupQuickChips(isService, item) {
            const wrap = document.getElementById('quickChips');
            wrap.style.display = 'flex';

            let chips = [];
            if (isService) {
                chips = [
                    '🛠 Вітаю! Хочу замовити вашу послугу',
                    '📅 Коли у вас є вільний час для виконання?',
                    '📍 Чи можливий виїзд за моєю адресою?',
                    '🤝 Яка остання ціна? Можливий торг?'
                ];
            } else {
                chips = [
                    '📦 Вітаю! Оголошення ще актуальне?',
                    '🤝 Яка остання ціна? Чи можливий торг?',
                    '📍 Де і коли зручно зустрітися?',
                    '🚚 Чи відправляєте поштою?'
                ];
            }

            wrap.innerHTML = chips.map(c => `
                <button type="button" class="quick-chip-btn" onclick="sendQuickText('${c.replace(/'/g, "\'")}')">${c}</button>
            `).join('');
        }

        // ЗАВАНТАЖЕННЯ ІСТОРІЇ
        async function loadChatHistory(partnerId, partnerName) {
            const chatArea = document.getElementById('chatArea');
            chatArea.innerHTML = '<div style="margin: auto; text-align: center; color: var(--text-muted); font-size: 0.88rem;">Завантаження листування...</div>';

            try {
                const res = await fetch(`/api/messages/history/${partnerId}`, {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const history = await res.json();

                if (!history || !history.length) {
                    chatArea.innerHTML = `
                        <div class="chat-empty-state">
                            <div class="empty-chat-icon">
                                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            </div>
                            <h3 class="empty-chat-title">Почніть діалог з ${partnerName}</h3>
                            <p class="empty-chat-subtitle">Обговоріть деталі замовлення або послуги. Ваші повідомлення доставляються миттєво в чат та дублюються в Telegram автора.</p>
                        </div>`;
                    updateMessageCounter(0);
                    return;
                }

                chatArea.innerHTML = '';
                history.forEach(m => {
                    const isSent = m.senderId === currentUserId;
                    appendMessage(m.text, isSent ? 'sent' : 'received', m.sentAt, m.isRead, false);
                });
                updateMessageCounter(history.length);
                chatArea.scrollTop = chatArea.scrollHeight;
            } catch(e) {
                console.error("Error loading chat history:", e);
                chatArea.innerHTML = '<div style="margin: auto; text-align: center; color: #ef4444;">Не вдалося завантажити повідомлення</div>';
            }
        }

        function updateMessageCounter(count) {
            const counter = document.getElementById('activeChatMsgCount');
            if (counter) {
                counter.innerText = count > 0 ? `• ${count} повідомлень` : '';
            }
        }

        // ДОДАВАННЯ ПОВІДОМЛЕННЯ В СТРІЧКУ
        function appendMessage(text, type, timeString, isRead = false, autoUpdateCount = true) {
            const chatArea = document.getElementById('chatArea');
            const emptyEl = chatArea.querySelector('.chat-empty-state');
            if (emptyEl) chatArea.innerHTML = '';

            let contentHtml = escapeHtml(text);
            if (text.startsWith('data:image')) {
                contentHtml = `<img src="${text}" class="msg-photo-thumb" onclick="openPhotoModal(this.src)">`;
            }

            const time = new Date(timeString || Date.now()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const checkIcon = isRead ? 
                '<span title="Прочитано" style="color: #60a5fa;">✓✓</span>' : 
                '<span title="Надіслано" style="opacity: 0.8;">✓</span>';

            const statusHtml = (type === 'sent') ? checkIcon : '';

            const bubbleHtml = `
                <div class="msg-bubble msg-${type}">
                    <div>${contentHtml}</div>
                    <div class="msg-time-row">
                        <span>${time}</span>
                        ${statusHtml}
                    </div>
                </div>
            `;

            chatArea.insertAdjacentHTML('beforeend', bubbleHtml);
            chatArea.scrollTop = chatArea.scrollHeight;

            if (autoUpdateCount) {
                const total = chatArea.querySelectorAll('.msg-bubble').length;
                updateMessageCounter(total);
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            const p = document.createElement('p');
            p.textContent = str;
            return p.innerHTML;
        }

        // НАДСИЛАННЯ ПОВІДОМЛЕННЯ
        async function sendMessage(customText = null) {
            const input = document.getElementById('messageInput');
            const text = customText || (input ? input.value.trim() : '');
            if (!text || !activeReceiverId) return;

            // 1. Оптимістично додаємо в чат
            appendMessage(text, 'sent', new Date(), false);
            if (!customText && input) input.value = '';

            // 2. Спроба SignalR
            let signalRSent = false;
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                try {
                    await connection.invoke("SendMessage", currentUserId.toString(), activeReceiverId.toString(), text);
                    signalRSent = true;
                } catch(e) {
                    console.log("SignalR SendMessage failed, using REST fallback:", e);
                }
            }

            // 3. Завжди підстраховуємо REST ендпоінтом для 100% збереження в базі та Telegram
            try {
                await fetch('/api/messages/send', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        receiverId: activeReceiverId,
                        text: text
                    })
                });
            } catch(e) {}

            loadDialogs();
        }

        function sendQuickText(text) {
            sendMessage(text);
        }

        // ВИДАЛЕННЯ ЧАТУ
        async function deleteChat() {
            if (!activeReceiverId) return;
            if (!confirm("Ви дійсно бажаєте видалити всю історію цього листування?")) return;

            try {
                await fetch(`/api/messages/dialogs/${activeReceiverId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                activeReceiverId = null;
                document.getElementById('inputBar').style.display = 'none';
                document.getElementById('quickChips').style.display = 'none';
                document.getElementById('headerActions').style.display = 'none';
                document.getElementById('productBadge').style.display = 'none';
                document.getElementById('activeChatName').innerText = 'Оберіть співрозмовника';
                document.getElementById('activeChatRole').style.display = 'none';
                document.getElementById('activeChatAvatar').innerHTML = '?';
                document.getElementById('activeChatMsgCount').innerText = '';
                
                document.getElementById('chatArea').innerHTML = `
                    <div class="chat-empty-state">
                        <div class="empty-chat-icon">
                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        </div>
                        <h3 class="empty-chat-title">Чат очищено</h3>
                        <p class="empty-chat-subtitle">Історію повідомлень успішно видалено.</p>
                    </div>`;

                loadDialogs();
            } catch(e) {
                console.error("Delete chat error:", e);
            }
        }

        // ОБРОБКА ФОТО
        function handlePhotoSelect(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 900;
                    let scale = 1;
                    if (img.width > MAX_WIDTH) scale = MAX_WIDTH / img.width;
                    canvas.width = img.width * scale;
                    canvas.height = img.height * scale;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    const b64 = canvas.toDataURL('image/jpeg', 0.65);
                    sendMessage(b64);
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function openPhotoModal(src) {
            document.getElementById('modalImg').src = src;
            document.getElementById('photoModal').style.display = 'flex';
        }

        // ШВИДКІ ЕМОДЗІ
        function toggleEmojiQuickBar() {
            const bar = document.getElementById('emojiQuickBar');
            bar.style.display = (bar.style.display === 'flex') ? 'none' : 'flex';
        }

        function insertEmoji(em) {
            const inp = document.getElementById('messageInput');
            inp.value += em;
            inp.focus();
            document.getElementById('emojiQuickBar').style.display = 'none';
        }

        // ENTER KEY
        document.getElementById('messageInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sendMessage();
            }
        });

        // СПОВІЩЕННЯ
        async function loadNotifications() {
            try {
                const res = await fetch('/api/notifications', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) {
                    const notifs = await res.json();
                    const badge = document.getElementById('notifBadge');
                    const unread = notifs.filter(n => !n.isRead);
                    if (unread.length > 0) {
                        badge.style.display = 'block';
                    } else {
                        badge.style.display = 'none';
                    }

                    const list = document.getElementById('notifList');
                    if (notifs.length === 0) {
                        list.innerHTML = '<p style="padding: 16px; text-align: center; color: var(--text-muted); font-size: 0.85rem;">Немає нових сповіщень</p>';
                    } else {
                        list.innerHTML = notifs.map(n => `
                            <a href="${n.link || '#'}" class="notif-item ${n.isRead ? '' : 'unread'}">
                                <div style="font-weight: 800; font-size: 0.86rem; margin-bottom: 2px;">${n.title}</div>
                                <div style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.35;">${n.message}</div>
                            </a>
                        `).join('');
                    }
                }
            } catch(e) {}
        }

        function toggleNotifications() {
            const d = document.getElementById('notifDropdown');
            d.style.display = (d.style.display === 'flex') ? 'none' : 'flex';
        }

        function clearNotifications() {
            document.getElementById('notifBadge').style.display = 'none';
            document.querySelectorAll('.notif-item').forEach(el => el.classList.remove('unread'));
            document.getElementById('notifDropdown').style.display = 'none';
        }

        // ВІДГУКИ ТА МОДАЛКА
        function openReviewModal() {
            if (!activeReceiverId) return;
            document.getElementById('reviewModal').style.display = 'flex';
        }

        function closeReviewModal() {
            document.getElementById('reviewModal').style.display = 'none';
        }

        async function submitReview(e) {
            e.preventDefault();
            const rating = parseInt(document.getElementById('reviewRating').value);
            const comment = document.getElementById('reviewComment').value.trim();
            if (!activeReceiverId) return;

            try {
                await fetch('/api/reviews', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${token}`
                    },
                    body: JSON.stringify({
                        targetUserId: activeReceiverId,
                        rating: rating,
                        comment: comment
                    })
                });
                alert("Дякуємо! Ваш відгук успішно додано.");
                closeReviewModal();
            } catch(err) {
                alert("Дякуємо за оцінку!");
                closeReviewModal();
            }
        }

        // ВИХІД
        function showLogoutModal() {
            document.getElementById('logoutModal').style.display = 'flex';
        }
        function closeLogoutModal() {
            document.getElementById('logoutModal').style.display = 'none';
        }
        function confirmLogoutAction() {
            localStorage.removeItem('loopToken');
            localStorage.removeItem('loopRefreshToken');
            localStorage.removeItem('loopUserRole');
            window.location.href = '/login.html';
        }

        // Клік поза модальними вікнами
        window.onclick = function(e) {
            if (e.target === document.getElementById('logoutModal')) closeLogoutModal();
            if (e.target === document.getElementById('reviewModal')) closeReviewModal();
            if (!e.target.closest('.notif-dropdown') && !e.target.closest('[onclick="toggleNotifications()"]')) {
                const dd = document.getElementById('notifDropdown');
                if (dd) dd.style.display = 'none';
            }
            if (!e.target.closest('.emoji-quick-bar') && !e.target.closest('[onclick="toggleEmojiQuickBar()"]')) {
                const eb = document.getElementById('emojiQuickBar');
                if (eb) eb.style.display = 'none';
            }
        };
    </script>
</body>
</html>
