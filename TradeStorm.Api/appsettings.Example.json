{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=loopmarket.db"
  },
  "Jwt": {
    "Key": "YOUR_SECRET_JWT_KEY_AT_LEAST_32_CHARACTERS_LONG_FOR_HMAC256",
    "Issuer": "LoopMarketApi",
    "Audience": "LoopMarketUsers"
  },
  "Telegram": {
    "BotToken": "YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER"
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    }
  }
}